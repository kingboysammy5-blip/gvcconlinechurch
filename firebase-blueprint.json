{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated congregation member profile synced with Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the member.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Member display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified member email address (PII, owner-only read).",
          "minLength": 3,
          "maxLength": 160
        },
        "bestScore": {
          "type": "integer",
          "description": "Personal high score in Shepherd's Light 2D game."
        },
        "gamesPlayed": {
          "type": "integer",
          "description": "Total completed Sanctuary game runs."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "bestScore", "gamesPlayed", "createdAt", "updatedAt"]
    },
    "ResearchBookmark": {
      "title": "ResearchBookmark",
      "description": "Saved Google Search-grounded Scripture and ministry insight generated with gemini-4-hydrogen.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "query": {
          "type": "string",
          "description": "User question submitted to the Search-Grounded assistant.",
          "minLength": 2,
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "description": "Grounded markdown response text.",
          "minLength": 1,
          "maxLength": 12000
        },
        "sourceTitles": {
          "type": "array",
          "description": "Bounded list of grounded web source titles (max 10)."
        },
        "sourceUrls": {
          "type": "array",
          "description": "Bounded list of grounded web source URLs (max 10)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "query", "answer", "sourceTitles", "sourceUrls", "createdAt", "updatedAt"]
    },
    "GameRun": {
      "title": "GameRun",
      "description": "Individual completed session in Shepherd's Light 2D Sanctuary Game.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "score": {
          "type": "integer",
          "description": "Final session score."
        },
        "wave": {
          "type": "integer",
          "description": "Highest wave reached."
        },
        "lambsSaved": {
          "type": "integer",
          "description": "Total lambs guided to the sanctuary fold."
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Duration of the run in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the run."
        }
      },
      "required": ["uid", "score", "wave", "lambsSaved", "durationSeconds", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Non-PII Sanctuary Game leaderboard entry per verified player.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Player Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public shepherd display name (no email/PII).",
          "minLength": 1,
          "maxLength": 80
        },
        "bestScore": {
          "type": "integer",
          "description": "Highest recorded score."
        },
        "bestWave": {
          "type": "integer",
          "description": "Highest wave reached."
        },
        "totalLambsSaved": {
          "type": "integer",
          "description": "Cumulative lambs guided safely."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "First entry timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest score update timestamp."
        }
      },
      "required": ["uid", "displayName", "bestScore", "bestWave", "totalLambsSaved", "createdAt", "updatedAt"]
    },
    "PrayerRequest": {
      "title": "PrayerRequest",
      "description": "User-submitted prayer request stored in Cloud Firestore prayer_requests collection with strict PII and privacy isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Verified Firebase Auth UID of the requester.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceNumber": {
          "type": "string",
          "description": "Unique prayer reference code (e.g., PRY-2026-AB12CD).",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^PRY-[0-9]{4}-[A-Z0-9]{4,12}$"
        },
        "requesterName": {
          "type": "string",
          "description": "Display name or Anonymous.",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Optional private contact phone number.",
          "minLength": 0,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Optional private contact email.",
          "minLength": 0,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Prayer focus category.",
          "enum": [
            "Personal prayer",
            "Family",
            "Health",
            "Spiritual growth",
            "Employment",
            "Financial needs",
            "Marriage",
            "Children",
            "Thanksgiving",
            "Other"
          ]
        },
        "requestContent": {
          "type": "string",
          "description": "Submitted prayer request content.",
          "minLength": 5,
          "maxLength": 4000
        },
        "privacyLevel": {
          "type": "string",
          "description": "Privacy level controlling pastoral vs public board visibility.",
          "enum": ["confidential", "prayer_team", "public_board", "public_testimony"]
        },
        "followupRequested": {
          "type": "boolean",
          "description": "Whether pastoral follow-up was requested."
        },
        "consent": {
          "type": "boolean",
          "description": "Explicit user consent flag."
        },
        "status": {
          "type": "string",
          "description": "Pastoral care lifecycle state.",
          "enum": ["New", "In Prayer", "Answered", "Archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "referenceNumber",
        "requesterName",
        "phone",
        "email",
        "category",
        "requestContent",
        "privacyLevel",
        "followupRequested",
        "consent",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChurchMember": {
      "title": "ChurchMember",
      "description": "Church member record imported via CSV or registered by church management in Firestore church_members collection.",
      "type": "object",
      "properties": {
        "memberNumber": {
          "type": "string",
          "description": "Unique GVCC member identifier (e.g., GVCC-2026-AB12CD).",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^GVCC-[0-9]{4}-[A-Z0-9]{4,12}$"
        },
        "fullName": {
          "type": "string",
          "description": "Member full name.",
          "minLength": 2,
          "maxLength": 140
        },
        "phone": {
          "type": "string",
          "description": "Primary contact phone number (PII).",
          "minLength": 4,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Optional member email address (PII).",
          "minLength": 0,
          "maxLength": 160
        },
        "location": {
          "type": "string",
          "description": "Residence, area, or village.",
          "minLength": 0,
          "maxLength": 140
        },
        "fellowshipGroup": {
          "type": "string",
          "description": "Assigned church fellowship group.",
          "minLength": 0,
          "maxLength": 120
        },
        "membershipType": {
          "type": "string",
          "description": "Category of church membership.",
          "enum": ["Existing member", "New member", "Youth", "Visitor convert", "Transfer"]
        },
        "membershipStatus": {
          "type": "string",
          "description": "Current pastoral membership status.",
          "enum": [
            "New registration",
            "Pending verification",
            "Contacted",
            "Orientation",
            "Active member",
            "Inactive",
            "Transferred",
            "Archived"
          ]
        },
        "registrationDate": {
          "type": "string",
          "description": "Date member joined or was registered (YYYY-MM-DD).",
          "minLength": 4,
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "description": "Optional pastoral or import notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "importedByUid": {
          "type": "string",
          "description": "Verified Firebase Auth UID of the administrator who imported the record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "importSource": {
          "type": "string",
          "description": "Origin of the Firestore member document.",
          "enum": ["csv_import", "manual_admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "memberNumber",
        "fullName",
        "phone",
        "email",
        "location",
        "fellowshipGroup",
        "membershipType",
        "membershipStatus",
        "registrationDate",
        "notes",
        "importedByUid",
        "importSource",
        "createdAt",
        "updatedAt"
      ]
    },
    "DirectoryMember": {
      "title": "DirectoryMember",
      "description": "Searchable church member record stored in the Firestore members collection and managed by verified administrators.",
      "type": "object",
      "properties": {
        "memberNumber": {
          "type": "string",
          "description": "Unique GVCC member identifier (e.g., GVCC-2026-AB12CD).",
          "minLength": 6,
          "maxLength": 40,
          "pattern": "^GVCC-[0-9]{4}-[A-Z0-9]{4,12}$"
        },
        "fullName": {
          "type": "string",
          "description": "Member full name.",
          "minLength": 2,
          "maxLength": 140
        },
        "phone": {
          "type": "string",
          "description": "Primary contact phone number (PII).",
          "minLength": 4,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "description": "Optional member email address (PII).",
          "minLength": 0,
          "maxLength": 160
        },
        "location": {
          "type": "string",
          "description": "Residence, area, or village.",
          "minLength": 0,
          "maxLength": 140
        },
        "fellowshipGroup": {
          "type": "string",
          "description": "Assigned church fellowship group.",
          "minLength": 0,
          "maxLength": 120
        },
        "membershipType": {
          "type": "string",
          "description": "Category of church membership.",
          "enum": ["Existing member", "New member", "Youth", "Visitor convert", "Transfer"]
        },
        "membershipStatus": {
          "type": "string",
          "description": "Current pastoral membership status.",
          "enum": [
            "New registration",
            "Pending verification",
            "Contacted",
            "Orientation",
            "Active member",
            "Inactive",
            "Transferred",
            "Archived"
          ]
        },
        "registrationDate": {
          "type": "string",
          "description": "Date member joined or was registered (YYYY-MM-DD).",
          "minLength": 4,
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "description": "Optional pastoral notes.",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdByUid": {
          "type": "string",
          "description": "Verified Firebase Auth UID of the administrator who created the record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "memberNumber",
        "fullName",
        "phone",
        "email",
        "location",
        "fellowshipGroup",
        "membershipType",
        "membershipStatus",
        "registrationDate",
        "notes",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile for signed-in GVCC members and visitors."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/ResearchBookmark" },
      "description": "Saved Google Search-grounded Scripture & ministry research bookmarks owned by the user."
    },
    "/users/{userId}/gameRuns/{runId}": {
      "schema": { "$ref": "#/entities/GameRun" },
      "description": "Immutable run logs for Shepherd's Light 2D game sessions."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Non-PII community leaderboard entries for Shepherd's Light 2D Sanctuary Game."
    },
    "/prayer_requests/{requestId}": {
      "schema": { "$ref": "#/entities/PrayerRequest" },
      "description": "Owner-isolated user-submitted prayer requests with optional private contact details."
    },
    "/church_members/{memberId}": {
      "schema": { "$ref": "#/entities/ChurchMember" },
      "description": "Confidential GVCC church membership directory bulk-imported or managed by verified administrators."
    },
    "/members/{memberId}": {
      "schema": { "$ref": "#/entities/DirectoryMember" },
      "description": "Confidential searchable GVCC church member directory stored in the Firestore members collection."
    }
  }
}
