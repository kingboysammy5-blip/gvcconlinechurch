# ==============================================================================
# Gracious Voice Celebration Centre (GVCC) - Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Search Grounding Scripture & Ministry Research.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public canonical URL of your Vercel, Netlify, or Cloud Run deployment.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE (Choose Option A OR Option B)
# ------------------------------------------------------------------------------
# Option A: Connection URI (Recommended for Vercel Postgres, Neon, Supabase, Railway)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_SSL="true"

# Option B: Individual Connection Fields (Used by Cloud SQL or custom Postgres)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# ADMINISTRATION PORTAL SECURITY
# ------------------------------------------------------------------------------
# Confidential passcode for the Administration Portal (defaults to 1234 if unset)
ADMIN_PORTAL_PASSCODE="1234"
# Long random secret used to sign administrative session tokens in production
ADMIN_TOKEN_SECRET="replace-with-a-long-random-secret-string"
