rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Pillar 0: Global Safety Net (Default Deny)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Pillar 3: Hardened Global Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'kingboysammy5@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Pillar 2: Standalone Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'bestScore', 'gamesPlayed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'bestScore', 'gamesPlayed', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000
        && data.gamesPlayed is int && data.gamesPlayed >= 0 && data.gamesPlayed <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, userId) {
      return data.keys().hasAll(['uid', 'query', 'answer', 'sourceTitles', 'sourceUrls', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'query', 'answer', 'sourceTitles', 'sourceUrls', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.query is string && data.query.size() >= 2 && data.query.size() <= 500
        && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 12000
        && data.sourceTitles is list && data.sourceTitles.size() <= 10
        && (data.sourceTitles.size() == 0 || (data.sourceTitles[0] is string && data.sourceTitles[0].size() <= 200))
        && data.sourceUrls is list && data.sourceUrls.size() <= 10
        && (data.sourceUrls.size() == 0 || (data.sourceUrls[0] is string && data.sourceUrls[0].size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGameRun(data, userId) {
      return data.keys().hasAll(['uid', 'score', 'wave', 'lambsSaved', 'durationSeconds', 'createdAt'])
        && data.keys().hasOnly(['uid', 'score', 'wave', 'lambsSaved', 'durationSeconds', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.score is int && data.score >= 0 && data.score <= 1000000
        && data.wave is int && data.wave >= 1 && data.wave <= 999
        && data.lambsSaved is int && data.lambsSaved >= 0 && data.lambsSaved <= 10000
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.createdAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'bestScore', 'bestWave', 'totalLambsSaved', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'bestScore', 'bestWave', 'totalLambsSaved', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 1000000
        && data.bestWave is int && data.bestWave >= 1 && data.bestWave <= 999
        && data.totalLambsSaved is int && data.totalLambsSaved >= 0 && data.totalLambsSaved <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrayerRequest(data, requestUserId) {
      return data.keys().hasAll([
          'uid', 'referenceNumber', 'requesterName', 'phone', 'email',
          'category', 'requestContent', 'privacyLevel', 'followupRequested',
          'consent', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'referenceNumber', 'requesterName', 'phone', 'email',
          'category', 'requestContent', 'privacyLevel', 'followupRequested',
          'consent', 'status', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == requestUserId
        && data.referenceNumber is string && data.referenceNumber.size() >= 6 && data.referenceNumber.size() <= 40 && data.referenceNumber.matches('^PRY-[0-9]{4}-[A-Z0-9]{4,12}$')
        && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 120
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.category in ['Personal prayer', 'Family', 'Health', 'Spiritual growth', 'Employment', 'Financial needs', 'Marriage', 'Children', 'Thanksgiving', 'Other']
        && data.requestContent is string && data.requestContent.size() >= 5 && data.requestContent.size() <= 4000
        && data.privacyLevel in ['confidential', 'prayer_team', 'public_board', 'public_testimony']
        && data.followupRequested is bool
        && data.consent is bool
        && data.status in ['New', 'In Prayer', 'Answered', 'Archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChurchMember(data, actorUid) {
      return data.keys().hasAll([
          'memberNumber', 'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'importedByUid', 'importSource',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'memberNumber', 'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'importedByUid', 'importSource',
          'createdAt', 'updatedAt'
        ])
        && data.memberNumber is string && data.memberNumber.size() >= 6 && data.memberNumber.size() <= 40 && data.memberNumber.matches('^GVCC-[0-9]{4}-[A-Z0-9]{4,12}$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.location is string && data.location.size() <= 140
        && data.fellowshipGroup is string && data.fellowshipGroup.size() <= 120
        && data.membershipType in ['Existing member', 'New member', 'Youth', 'Visitor convert', 'Transfer']
        && data.membershipStatus in ['New registration', 'Pending verification', 'Contacted', 'Orientation', 'Active member', 'Inactive', 'Transferred', 'Archived']
        && data.registrationDate is string && data.registrationDate.size() >= 4 && data.registrationDate.size() <= 32
        && data.notes is string && data.notes.size() <= 1000
        && data.importedByUid is string && data.importedByUid.size() >= 1 && data.importedByUid.size() <= 128 && data.importedByUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.importedByUid == actorUid
        && data.importSource in ['csv_import', 'manual_admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDirectoryMember(data, actorUid) {
      return data.keys().hasAll([
          'memberNumber', 'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'memberNumber', 'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'createdByUid', 'createdAt', 'updatedAt'
        ])
        && data.memberNumber is string && data.memberNumber.size() >= 6 && data.memberNumber.size() <= 40 && data.memberNumber.matches('^GVCC-[0-9]{4}-[A-Z0-9]{4,12}$')
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 140
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 160
        && data.location is string && data.location.size() <= 140
        && data.fellowshipGroup is string && data.fellowshipGroup.size() <= 120
        && data.membershipType in ['Existing member', 'New member', 'Youth', 'Visitor convert', 'Transfer']
        && data.membershipStatus in ['New registration', 'Pending verification', 'Contacted', 'Orientation', 'Active member', 'Inactive', 'Transferred', 'Archived']
        && data.registrationDate is string && data.registrationDate.size() >= 4 && data.registrationDate.size() <= 32
        && data.notes is string && data.notes.size() <= 1000
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 && data.createdByUid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.createdByUid == actorUid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // /admins/{adminUid} - Explicit role lookup documents
    // -------------------------------------------------------------------------
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // /users/{userId} - Owner-isolated PII Profile
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bestScore', 'gamesPlayed', 'updatedAt'])
        );

      allow delete: if false;

      // -----------------------------------------------------------------------
      // Master Gate Subcollection: /users/{userId}/bookmarks/{bookmarkId}
      // -----------------------------------------------------------------------
      match /bookmarks/{bookmarkId} {
        function parentMatchesOwner() {
          return exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        }

        allow get: if isValidId(userId) && isValidId(bookmarkId)
          && ((isOwner(userId) && parentMatchesOwner()) || isAdmin());

        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidId(bookmarkId)
          && isOwner(userId)
          && isValidBookmark(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentMatchesOwner();

        allow update: if isValidId(userId) && isValidId(bookmarkId)
          && ((isOwner(userId) && parentMatchesOwner()) || isAdmin())
          && isValidBookmark(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            incoming().diff(existing()).affectedKeys().hasOnly(['query', 'answer', 'sourceTitles', 'sourceUrls', 'updatedAt'])
          );

        allow delete: if isValidId(userId) && isValidId(bookmarkId)
          && ((isOwner(userId) && parentMatchesOwner()) || isAdmin());
      }

      // -----------------------------------------------------------------------
      // Master Gate Subcollection: /users/{userId}/gameRuns/{runId}
      // -----------------------------------------------------------------------
      match /gameRuns/{runId} {
        function parentUserMatches() {
          return exists(/databases/$(database)/documents/users/$(userId))
            && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        }

        allow get: if isValidId(userId) && isValidId(runId)
          && ((isOwner(userId) && parentUserMatches()) || isAdmin());

        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidId(runId)
          && isOwner(userId)
          && isValidGameRun(incoming(), userId)
          && incoming().createdAt == request.time
          && parentUserMatches();

        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /leaderboard/{userId} - Non-PII Sanctuary Game Leaderboard
    // -------------------------------------------------------------------------
    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.bestScore >= 0;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bestScore', 'bestWave', 'totalLambsSaved', 'updatedAt'])
            && incoming().bestScore >= existing().bestScore
            && incoming().bestWave >= existing().bestWave
            && incoming().totalLambsSaved >= existing().totalLambsSaved
          )
        );

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /prayer_requests/{requestId} - Owner-Isolated Prayer Requests Collection
    // -------------------------------------------------------------------------
    match /prayer_requests/{requestId} {
      allow get: if isValidId(requestId)
        && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));

      allow list: if isBootstrappedAdmin()
        || (isVerifiedUser() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(requestId)
        && isVerifiedUser()
        && isValidPrayerRequest(incoming(), request.auth.uid)
        && incoming().status == 'New'
        && incoming().consent == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid))
        && isValidPrayerRequest(incoming(), existing().uid)
        && incoming().uid == existing().uid
        && incoming().referenceNumber == existing().referenceNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'Archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['requestContent', 'category', 'privacyLevel', 'followupRequested', 'updatedAt'])
          )
        );

      allow delete: if isValidId(requestId)
        && (isAdmin() || (isVerifiedUser() && existing().uid == request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // /church_members/{memberId} - Confidential Admin-Only Church Members
    // -------------------------------------------------------------------------
    match /church_members/{memberId} {
      allow get: if isValidId(memberId) && isAdmin();

      allow list: if isBootstrappedAdmin()
        || (isVerifiedUser() && resource.data.importedByUid == request.auth.uid);

      allow create: if isValidId(memberId)
        && isVerifiedUser()
        && isAdmin()
        && isValidChurchMember(incoming(), request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(memberId)
        && isVerifiedUser()
        && isAdmin()
        && isValidChurchMember(incoming(), existing().importedByUid)
        && incoming().importedByUid == existing().importedByUid
        && incoming().memberNumber == existing().memberNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'importSource', 'updatedAt'
        ]);

      allow delete: if isValidId(memberId) && isAdmin();
    }

    // -------------------------------------------------------------------------
    // /members/{memberId} - Confidential Admin-Only Searchable Member Directory
    // -------------------------------------------------------------------------
    match /members/{memberId} {
      allow get: if isValidId(memberId) && isAdmin();

      allow list: if isBootstrappedAdmin()
        || (isVerifiedUser() && resource.data.createdByUid == request.auth.uid);

      allow create: if isValidId(memberId)
        && isVerifiedUser()
        && isAdmin()
        && isValidDirectoryMember(incoming(), request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(memberId)
        && isVerifiedUser()
        && isAdmin()
        && isValidDirectoryMember(incoming(), existing().createdByUid)
        && incoming().createdByUid == existing().createdByUid
        && incoming().memberNumber == existing().memberNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName', 'phone', 'email', 'location',
          'fellowshipGroup', 'membershipType', 'membershipStatus',
          'registrationDate', 'notes', 'updatedAt'
        ]);

      allow delete: if isValidId(memberId) && isAdmin();
    }
  }
}
